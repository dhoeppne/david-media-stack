# =======================================================
# =======================UNIVERSAL=======================
# =======================================================
TZ=America/Vancouver
PUID=1000
PGID=1000

# Config directory (holds per-service config subdirectories)
CONFIGROOT=/mnt/user/appdata/mediastack

# Data root — local path on the NAS filesystem.
# Must contain torrents/ and media/ subdirectories.
# This is also the path you export via NFS for the server to mount.
DATAROOT=/mnt/user/data

# =======================================================
# =========================PLEX==========================
# =======================================================
PLEX_CLAIM=short-lived-code

# =======================================================
# ========================GLUETUN========================
# =======================================================
WIREGUARD_KEY=dont-share-this-key
WIREGUARD_ADDRESS=ipv4-or-ipv6
SERVER_CITIES=Vancouver
