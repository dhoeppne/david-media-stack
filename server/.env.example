# =======================================================
# =======================UNIVERSAL=======================
# =======================================================
TZ=America/Vancouver
# Must match PUID/PGID on the NAS for NFS permission consistency
PUID=1000
PGID=1000

# Config directory on this server (local storage, not NFS)
CONFIGROOT=/opt/mediastack/config

# =======================================================
# =========================NAS===========================
# =======================================================
# LAN IP address of the NAS
NAS_IP=192.168.1.100
# NFS export path on the NAS (the directory containing torrents/ and media/)
NAS_NFS_PATH=/mnt/user/data
