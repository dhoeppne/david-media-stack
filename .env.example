# =======================================================
# =======================UNIVERSAL=======================
# =======================================================
# Your timezone
TZ=America/Vancouver
# PUID
PUID=1000
PGID=1000

# Config directory (holds per-service config subdirectories)
CONFIGROOT=/example/directory/where/you/want/your/configs/to/live

# Data root — must contain torrents/ and media/ subdirectories.
# See README.md for the expected folder structure (TRaSH hardlinks layout).
DATAROOT=/example/directory/where/you/want/your/media/to/live

# =======================================================
# =========================PLEX==========================
# =======================================================
PLEX_CLAIM=short-lived-code

# =======================================================
# ========================GLUETUN========================
# =======================================================
WIREGUARD_KEY=dont-share-this-key
WIREGUARD_ADDRESS=ipv4-or-ipv6
SERVER_CITIES=Vancouver
